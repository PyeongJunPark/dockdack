# Preserve bytes used by the mark1 prototype's SHA-256 integrity contract.
# Windows autocrlf must not rewrite JSON manifests or frozen inference sources.
models/mark1_prototype/** -text whitespace=cr-at-eol
dockdack/mark1_selective_features.py -text
dockdack/mark1_selective_models.py -text
dockdack/mark1_metrics.py -text
# The independent 0.5/0.4 bundle also freezes its barrier-feature bytes.
models/mark1_0504/** -text whitespace=cr-at-eol
dockdack/mark1_0504_data.py -text
# Named mark1.1 bundle and its identity wrapper are also SHA-256 sealed.
models/mark1_1_prototype/** -text whitespace=cr-at-eol
dockdack/mark1_1_prototype_inference.py -text
# Source bytes recorded in the frozen training/export contracts.
dockdack/mark1_prototype_inference.py -text
dockdack/mark1_0504_inference.py -text
dockdack/mark1_data.py -text
dockdack/mark1_deep_data.py -text
dockdack/mark1_deep_validation.py -text
dockdack/mark1_selective_policy.py -text
examples/train_mark1.py -text
examples/train_mark1_deep.py -text
examples/train_mark1_selective.py -text
examples/train_mark1_0504.py -text
examples/backtest_mark1_deep.py -text
# Machine-exported tree dumps are retained, not rendered as giant review diffs.
models/**/*.cbm.json -diff
# Historical report/backtest contracts include these original source bytes.
dockdack/mark1_0504_backtest.py -text whitespace=cr-at-eol,-blank-at-eof
examples/report_mark1_deep.py -text whitespace=cr-at-eol,-blank-at-eol
