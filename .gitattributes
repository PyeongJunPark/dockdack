# Preserve bytes used by the mark1 prototype's SHA-256 integrity contract.
# Windows autocrlf must not rewrite JSON manifests or frozen inference sources.
models/mark1_prototype/** -text whitespace=cr-at-eol
dockdack/mark1_selective_features.py -text
dockdack/mark1_selective_models.py -text
dockdack/mark1_metrics.py -text
# The independent 0.5/0.4 bundle also freezes its barrier-feature bytes.
models/mark1_0504/** -text whitespace=cr-at-eol
dockdack/mark1_0504_data.py -text
# Named mark1.1 bundle and its identity wrapper are also SHA-256 sealed.
models/mark1_1_prototype/** -text whitespace=cr-at-eol
dockdack/mark1_1_prototype_inference.py -text
# Mark1.2 stores byte-level seals for its model files and runtime/training code.
# Keep LF bytes unchanged on Windows as well as non-Windows checkouts.
models/mark1_2_prototype/** -text whitespace=cr-at-eol
dockdack/mark1_2_data.py -text
dockdack/mark1_2_models.py -text
dockdack/mark1_2_inference.py -text
examples/train_mark1_2.py -text
examples/export_mark1_2.py -text
examples/backtest_mark1_2.py -text
examples/finish_mark1_2.py -text
# Mark1.3 verifies the bundle and the original feature source by raw SHA-256.
models/mark1_3/** -text whitespace=cr-at-eol
dockdack/mark1_3_research.py -text
# Mark1.4-1.12 compare raw bundle and scorer bytes against frozen SHA-256 seals.
# Preserve each file's original LF or CRLF bytes across Windows/Linux checkouts.
models/mark1_4/** -text whitespace=cr-at-eol
models/mark1_series/** -text whitespace=cr-at-eol
models/mark1_8/** -text whitespace=cr-at-eol
models/mark1_9/** -text whitespace=cr-at-eol
models/mark1_10/** -text whitespace=cr-at-eol
models/mark1_horizons/** -text whitespace=cr-at-eol
# MK1.13–MK1.22 seals include raw checkpoint/manifest and feature-source bytes.
models/mark1_intraday/** -text whitespace=cr-at-eol
models/mark1_intraday_extra/** -text whitespace=cr-at-eol
dockdack/mark1_intraday_models.py -text
dockdack/mark1_intraday_extra_models.py -text
# MK1.23-MK1.28 bundle seals raw manifest, checkpoint and feature bytes.
models/mark1_target_horizon_v1/** -text whitespace=cr-at-eol
dockdack/mark1_target_horizon_models.py -text
examples/train_mark1_target_horizon_prototypes.py -text
# Daily-trained minute prototype manifests/checkpoints also preserve raw seals.
models/mark1_minute/** -text whitespace=cr-at-eol
dockdack/mark1_4_evolution.py -text
dockdack/mark1_4_followup_models.py -text
dockdack/mark1_4_sparse.py -text
dockdack/mark1_series_models.py -text
# Source bytes recorded in the frozen training/export contracts.
dockdack/mark1_prototype_inference.py -text
dockdack/mark1_0504_inference.py -text
dockdack/mark1_data.py -text
dockdack/mark1_deep_data.py -text
dockdack/mark1_deep_models.py -text
dockdack/mark1_deep_validation.py -text
dockdack/mark1_selective_policy.py -text
examples/train_mark1.py -text
examples/train_mark1_deep.py -text
examples/train_mark1_selective.py -text
examples/train_mark1_0504.py -text
examples/backtest_mark1_deep.py -text
# Machine-exported tree dumps are retained, not rendered as giant review diffs.
models/**/*.cbm.json -diff
# Historical report/backtest contracts include these original source bytes.
dockdack/mark1_0504_backtest.py -text whitespace=cr-at-eol,-blank-at-eof
examples/report_mark1_deep.py -text whitespace=cr-at-eol,-blank-at-eol
